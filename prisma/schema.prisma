// ============================================================================
// PRISMA SCHEMA - TeamForge Backend
// ============================================================================
// Simplified, normalized schema focused on core requirements:
// - Age-based profile (not birthDate)
// - Simple Plan-Group relationship
// - Essential enums only
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

// ============================================================================
// AUTHENTICATION & USER
// ============================================================================

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  password      String?          // Null for OAuth users
  name          String
  avatar        String?
  bio           String?
  authProvider  AuthProviderType @default(EMAIL) @map("auth_provider")
  emailVerified Boolean          @default(false) @map("email_verified")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  // --- Profile ---
  age             Int?
  gender          Gender?
  city            String?
  personalityType String? @map("personality_type") // 4-letter type code (e.g., "INFP", "ESTJ")

  // --- Matching ---
  searchStatus    SearchStatus @default(IDLE) @map("search_status")
  trustScore      Float        @default(0.5) @map("trust_score")
  profileComplete Boolean      @default(false) @map("profile_complete")

  // --- Relations ---
  interests           UserInterest[]
  sentFriendships     Friendship[]      @relation("FriendshipRequester")
  receivedFriendships Friendship[]      @relation("FriendshipReceiver")
  createdActivities   Activity[]        @relation("ActivityCreator")
  groupMemberships    GroupMember[]
  sentMessages        Message[]
  notifications       Notification[]
  invitesSent         Invite[]          @relation("InviteSender")
  invitesReceived     Invite[]          @relation("InviteReceiver")
  ratingsGiven        Rating[]          @relation("RatingGiver")
  ratingsReceived     Rating[]          @relation("RatingReceiver")
  chatParticipations  ChatParticipant[]
  reactions           Reaction[]
  proposals           PlanProposal[]    @relation("ProposalAuthor")
  proposalVotes       ProposalVote[]
  planComments        PlanComment[]
  sessions            Session[]
  otpCodes            OtpCode[]

  @@index([email])
  @@index([city])
  @@index([searchStatus])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpCode {
  id        String     @id @default(cuid())
  code      String
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ============================================================================
// INTERESTS (Self-referential hierarchy)
// ============================================================================

model Interest {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  icon        String?
  color       String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  parentId String?    @map("parent_id")
  parent   Interest?  @relation("InterestHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Interest[] @relation("InterestHierarchy")

  aliases String[] @default([])

  users      UserInterest[]
  activities ActivityInterest[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([slug])
  @@map("interests")
}

model UserInterest {
  addedAt DateTime @default(now()) @map("added_at")

  userId     String @map("user_id")
  interestId String @map("interest_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

// ============================================================================
// ACTIVITIES & GROUPS
// ============================================================================

model Activity {
  id          String             @id @default(cuid())
  title       String
  description String?
  city        String?
  visibility  ActivityVisibility @default(PUBLIC)
  forgeMode   ForgeMode          @default(AUTO) @map("forge_mode")
  status      ActivityStatus     @default(OPEN)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  creatorId String @map("creator_id")
  creator   User   @relation("ActivityCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  interests ActivityInterest[]
  group     Group?

  @@index([city])
  @@index([creatorId])
  @@index([status])
  @@index([deletedAt])
  @@map("activities")
}

model ActivityInterest {
  activityId String @map("activity_id")
  interestId String @map("interest_id")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([activityId, interestId])
  @@map("activity_interests")
}

model Group {
  id          String      @id @default(cuid())
  name        String
  description String?
  avatar      String?
  status      GroupStatus @default(FORMING)
  maxMembers  Int         @default(6) @map("max_members") // Range: 2-16
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  disbandedAt DateTime?   @map("disbanded_at")

  activityId String   @unique @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  members GroupMember[]
  plan    Plan?
  chat    Chat?
  invites Invite[]
  ratings Rating[]

  @@index([status])
  @@index([disbandedAt])
  @@map("groups")
}

model GroupMember {
  role               GroupRole @default(MEMBER)
  joinedAt           DateTime  @default(now()) @map("joined_at")
  leftAt             DateTime? @map("left_at")
  compatibilityScore Float?    @map("compatibility_score")

  userId  String @map("user_id")
  groupId String @map("group_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("group_members")
}

// ============================================================================
// PLANS (Simple 1:1 with Group)
// ============================================================================

model Plan {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    PlanCategory
  coverImage  String?      @map("cover_image")
  status      PlanStatus   @default(DRAFT)

  dateTime DateTime? @map("date_time")

  locationMode LocationMode @default(IN_PERSON) @map("location_mode")
  location     String?
  locationLat  Float?       @map("location_lat")
  locationLng  Float?       @map("location_lng")

  cost        CostType @default(FREE)
  costAmount  Float?   @map("cost_amount")
  costDetails String?  @map("cost_details")

  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groupId String @unique @map("group_id")
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  proposals PlanProposal[]
  comments  PlanComment[]

  @@index([status])
  @@index([dateTime])
  @@map("plans")
}

model PlanProposal {
  id            String         @id @default(cuid())
  field         PlanField
  currentValue  String?        @map("current_value")
  proposedValue String         @map("proposed_value")
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now()) @map("created_at")
  resolvedAt    DateTime?      @map("resolved_at")

  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  proposerId String @map("proposer_id")
  proposer   User   @relation("ProposalAuthor", fields: [proposerId], references: [id], onDelete: Cascade)

  votes ProposalVote[]

  @@index([planId, status])
  @@map("plan_proposals")
}

model ProposalVote {
  vote      VoteType
  createdAt DateTime @default(now()) @map("created_at")

  proposalId String       @map("proposal_id")
  proposal   PlanProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([proposalId, userId])
  @@map("proposal_votes")
}

model PlanComment {
  id        String     @id @default(cuid())
  field     PlanField?
  content   String
  createdAt DateTime   @default(now()) @map("created_at")
  editedAt  DateTime?  @map("edited_at")

  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_comments")
}

// ============================================================================
// SOCIAL - FRIENDSHIPS
// ============================================================================

model Friendship {
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  requesterId String @map("requester_id")
  receiverId  String @map("receiver_id")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  privateChatId String? @unique @map("private_chat_id")
  privateChat   Chat?   @relation(fields: [privateChatId], references: [id], onDelete: SetNull)

  @@id([requesterId, receiverId])
  @@index([receiverId])
  @@map("friendships")
}

// ============================================================================
// CHAT & MESSAGING
// ============================================================================

model Chat {
  id        String   @id @default(cuid())
  type      ChatType
  createdAt DateTime @default(now()) @map("created_at")

  groupId String? @unique @map("group_id")
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  friendship Friendship?

  pinnedMessageId String?  @unique @map("pinned_message_id")
  pinnedMessage   Message? @relation("PinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

  participants ChatParticipant[]
  messages     Message[]

  @@map("chats")
}

model ChatParticipant {
  isMuted   Boolean   @default(false) @map("is_muted")
  isBlocked Boolean   @default(false) @map("is_blocked")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  lastReadMessageId String? @map("last_read_message_id")

  userId String @map("user_id")
  chatId String @map("chat_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
  @@index([chatId])
  @@map("chat_participants")
}

model Message {
  id        String        @id @default(cuid())
  type      MessageType   @default(TEXT)
  content   String
  status    MessageStatus @default(SENT)
  isEdited  Boolean       @default(false) @map("is_edited")
  createdAt DateTime      @default(now()) @map("created_at")
  editedAt  DateTime?     @map("edited_at")
  deletedAt DateTime?     @map("deleted_at")

  chatId String @map("chat_id")
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  senderId String @map("sender_id")
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  replyToId String?   @map("reply_to_id")
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  reactions   Reaction[]
  attachments Attachment[]
  pinnedIn    Chat?        @relation("PinnedMessage")

  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([deletedAt])
  @@map("messages")
}

model Attachment {
  id           String         @id @default(cuid())
  type         AttachmentType
  url          String
  name         String?
  size         Int?
  mimeType     String?        @map("mime_type")
  thumbnailUrl String?        @map("thumbnail_url")
  duration     Int?
  waveform     Float[]        @default([])
  createdAt    DateTime       @default(now()) @map("created_at")

  messageId String  @map("message_id")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

model Reaction {
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  messageId String  @map("message_id")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@map("reactions")
}

// ============================================================================
// RATINGS & TRUST
// ============================================================================

model Rating {
  id        String   @id @default(cuid())
  score     Int      // 1-5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  raterId String @map("rater_id")
  rater   User   @relation("RatingGiver", fields: [raterId], references: [id], onDelete: Cascade)

  rateeId String @map("ratee_id")
  ratee   User   @relation("RatingReceiver", fields: [rateeId], references: [id], onDelete: Cascade)

  groupId String @map("group_id")
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([raterId, rateeId, groupId])
  @@index([rateeId])
  @@map("ratings")
}

// ============================================================================
// INVITES & NOTIFICATIONS
// ============================================================================

model Invite {
  id          String       @id @default(cuid())
  type        InviteType
  status      InviteStatus @default(PENDING)
  message     String?
  createdAt   DateTime     @default(now()) @map("created_at")
  expiresAt   DateTime?    @map("expires_at")
  respondedAt DateTime?    @map("responded_at")

  groupId String @map("group_id")
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  inviteeId String @map("invitee_id")
  invitee   User   @relation("InviteReceiver", fields: [inviteeId], references: [id], onDelete: Cascade)

  inviterId String? @map("inviter_id")
  inviter   User?   @relation("InviteSender", fields: [inviterId], references: [id], onDelete: SetNull)

  @@unique([groupId, inviteeId])
  @@index([inviteeId, status])
  @@map("invites")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  avatarUrl String?          @map("avatar_url")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  entityType EntityType? @map("entity_type")
  entityId   String?     @map("entity_id")

  receiverId String @map("receiver_id")
  receiver   User   @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

// ============================================================================
// ENUMS (Simplified)
// ============================================================================

enum AuthProviderType {
  EMAIL
  GOOGLE
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

enum SearchStatus {
  IDLE
  SEARCHING
}

enum ActivityVisibility {
  PUBLIC
  FRIENDS_ONLY
  INVITE_ONLY
}

enum ActivityStatus {
  OPEN
  MATCHING
  MATCHED
  CLOSED
  CANCELLED
}

enum ForgeMode {
  AUTO
  MANUAL
}

enum GroupStatus {
  FORMING
  PENDING
  ACTIVE
  PLANNING
  COMPLETED
  DISBANDED
}

enum GroupRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum PlanCategory {
  TECH
  SPORTS
  ARTS
  SOCIAL
  OUTDOORS
  LEARNING
  MUSIC
  FOOD
  GAMING
  WELLNESS
  TRAVEL
  OTHER
}

enum PlanStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlanField {
  TITLE
  DESCRIPTION
  DATE_TIME
  LOCATION
  COST
  CATEGORY
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VoteType {
  APPROVE
  REJECT
}

enum LocationMode {
  IN_PERSON
  ONLINE
}

enum CostType {
  FREE
  PAID
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum ChatType {
  GROUP
  PRIVATE
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  FILE
  SYSTEM
  PLAN_UPDATE
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum InviteType {
  ALGORITHM_MATCH
  FRIEND_INVITE
  DIRECT_INVITE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GROUP_FORMED
  GROUP_INVITE
  GROUP_JOIN_REQUEST
  GROUP_JOIN_APPROVED
  GROUP_MEMBER_LEFT
  GROUP_DISBANDED
  PLAN_CREATED
  PLAN_CONFIRMED
  PLAN_UPDATED
  PLAN_PROPOSAL
  PLAN_STARTING_SOON
  PLAN_COMPLETED
  PLAN_CANCELLED
  NEW_MESSAGE
  MESSAGE_MENTION
  RATING_REQUEST
  RATING_RECEIVED
  SYSTEM_ANNOUNCEMENT
  ACCOUNT_SECURITY
}

enum EntityType {
  USER
  GROUP
  PLAN
  ACTIVITY
  MESSAGE
  INVITE
}
