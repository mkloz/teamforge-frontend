{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "public/sw-push.js",
    "src/main.tsx",
    "src/router.tsx",
    "vite.config.ts",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.ts"
  ],
  "health": {
    "maxCrap": 56,
    "crapRefactorBand": 0
  },
  "ignoreDependencies": [
    "@doist/react-compiler-tracker",
    "babel-plugin-react-compiler",
    "react-doctor",
    "repomix"
  ],
  "ignoreExports": [
    {
      "file": "src/features/auth/lib/google-auth-flow.ts",
      "exports": ["preloadGoogleIdentityScript", "requestGoogleAuthCode"]
    },
    {
      "file": "src/features/legal/legal-page.tsx",
      "exports": ["LegalPage"]
    },
    {
      "file": "src/features/activity/api/activity-context.ts",
      "exports": ["deriveActivityFeedData", "mergeActivityConversationTimeline"]
    },
    {
      "file": "src/features/activity/api/context/activity-context-projections.ts",
      "exports": ["deriveActivityFeedData", "mergeActivityConversationTimeline"]
    },
    {
      "file": "src/shared/schemas/social.ts",
      "exports": ["friendshipSchema", "ratingSchema"]
    }
  ]
}
