# Copy to .env.audit.local for authenticated local audits.
# Never commit real credentials.

AUDIT_USER_EMAIL=your-local-audit-user@example.com
AUDIT_USER_PASSWORD=your-local-audit-password

# Optional overrides:
# AUDIT_BASE_URL=http://127.0.0.1:4173
# AUDIT_OUTPUT_ROOT=reports/authenticated-audit-local
# AUDIT_RUN_LOADED=true
# AUDIT_RUN_PLAYWRIGHT=false
# AUDIT_RUN_LIGHTHOUSE=false
# AUDIT_RUN_SQUIRREL=false
# AUDIT_PLAYWRIGHT_LANES=route-health
# AUDIT_PLAYWRIGHT_ROUTE_SET=authenticated
# Unset AUDIT_AXE_FAIL_IMPACTS for report-only axe scans.
# AUDIT_AXE_FAIL_IMPACTS=critical,serious
# AUDIT_LIGHTHOUSE_ROUTE_SLUGS=01-landing,02-download,14-home
# AUDIT_LIGHTHOUSE_CATEGORIES=performance,accessibility,best-practices,seo
# AUDIT_LIGHTHOUSE_IGNORE_CERT_ERRORS=true
# AUDIT_PREVIEW_PORT=4173
# AUDIT_START_PREVIEW=true
# AUDIT_PREVIEW_HTTPS=auto
# AUDIT_PREVIEW_CERT_PATH=temp/certs/teamforge-audit.crt
# AUDIT_PREVIEW_KEY_PATH=temp/certs/teamforge-audit.key
# AUDIT_API_PROXY_PATH=/__audit_api
# AUDIT_API_PROXY_TARGET=http://localhost:6969/api/v1
# AUDIT_BROWSER_API_URL=https://127.0.0.1:4173/__audit_api
# AUDIT_PLAYWRIGHT_CHANNEL=chrome

# Browser-only release/nightly policy:
# - npm run audit:release runs Playwright route-health + axe and narrow Lighthouse.
# - npm run audit:nightly uses the same Playwright lanes and a broader Lighthouse route set.
# - Both commands write compact reports under reports/browser-audit-*/ and skip the
#   legacy loaded-route and SquirrelScan lanes unless you override AUDIT_RUN_*.
#
# Run `npm run audit:cert` on Windows to generate a 127.0.0.1/localhost
# certificate, trust it in the Current User root store, and write the three
# preview HTTPS settings above into `.env.audit.local`.
#
# The authenticated pipeline serves `dist/` through scripts/audit/static-preview-server.mjs
# so local SquirrelScan sees the same security headers configured in vercel.json.
# The audit server also serves origin-aware robots.txt and sitemap.xml for local crawls.
# When preview HTTPS is enabled, the pipeline bakes a same-origin
# `/__audit_api` URL into the audit build and proxies it server-side to the
# local backend. That keeps SquirrelScan from flagging mixed-content API URLs
# while the backend can still run at http://localhost:6969/api/v1.
# To clear local-only HTTPS and HTTP/2 findings, point
# AUDIT_PREVIEW_CERT_PATH/AUDIT_PREVIEW_KEY_PATH at a locally trusted certificate
# for 127.0.0.1. With AUDIT_PREVIEW_HTTPS unset or set to auto, the pipeline
# automatically serves HTTPS when both certificate paths are configured. Use
# AUDIT_PREVIEW_HTTPS=false only when intentionally testing HTTP. SquirrelScan
# does not expose a skip-TLS flag, so self-signed certificates must be trusted by
# the crawler runtime before use.
# Antivirus HTTPS inspection can replace the local certificate with its own
# generated certificate. If that happens, either disable inspection for
# 127.0.0.1 during local audits or trust the inspection root in the runtime used
# by SquirrelScan.
