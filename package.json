{
  "name": "teamforge-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/scenario/check-production-boundary.mjs",
    "preview": "vite preview",
    "scenario:dev": "vite --mode scenario --host 127.0.0.1",
    "scenario:build": "tsc -b && vite build --mode scenario",
    "scenario:preview": "vite preview --outDir dev-dist/scenario --host 127.0.0.1",
    "scenario:audit": "node scripts/scenario/run-visual-audit.mjs smoke",
    "scenario:audit:full": "node scripts/scenario/run-visual-audit.mjs full",
    "scenario:check-production": "node scripts/scenario/check-production-boundary.mjs",
    "test": "vitest run test/unit",
    "lint": "node scripts/lint/full.mjs",
    "lint:feature-seams": "node scripts/lint/feature-import-seams.mjs --strict",
    "lint:fix": "node scripts/lint/fix.mjs",
    "check:changed": "node scripts/lint/changed.mjs --full-oxlint",
    "check:local": "node scripts/verify/index.mjs local",
    "check:pr": "node scripts/verify/index.mjs pr",
    "check:release": "node scripts/verify/index.mjs release",
    "pwa:release": "node scripts/pwa/release.mjs",
    "audit:release": "node scripts/audit/run-browser-audits.mjs release",
    "audit:nightly": "node scripts/audit/run-browser-audits.mjs nightly",
