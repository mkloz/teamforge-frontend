{
  "name": "teamforge-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:oxlint && npm run lint:biome && npm run lint:types",
    "lint:fix": "biome check --write --no-errors-on-unmatched . && biome format --write --no-errors-on-unmatched . && npx knip",
    "lint:oxlint": "oxlint --config .oxlintrc.json --format stylish --no-error-on-unmatched-pattern .",
    "lint:biome": "biome check --no-errors-on-unmatched .",
    "lint:types": "tsc -b",
    "test:unit": "vitest run",
    "check": "npm run lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-oauth/google": "^0.13.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.162.9",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-delaunay": "^6.0.4",
    "dayjs": "^1.11.19",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.3",
    "input-otp": "^1.4.2",
    "ky": "^1.14.3",
    "lucide-react": "^0.575.0",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@bensandee/eslint-plugin": "^0.12.0",
    "@biomejs/biome": "^2.4.14",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "knip": "^6.12.0",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.63.0",
    "oxlint-plugin-inhuman": "^0.1.9",
    "oxlint-plugin-query": "^0.1.1",
    "oxlint-tailwindcss": "^0.7.1",
    "oxlint-tsgolint": "^0.22.1",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-biome": "^1.2.0",
    "vite-plugin-oxlint": "^2.1.1",
    "vitest": "^4.1.5"
  }
}
