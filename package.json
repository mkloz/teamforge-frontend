{
  "name": "teamforge-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "lint": "npm run lint:oxlint && npm run lint:compiler && npm run lint:biome && npm run lint:architecture && npm run lint:fallow && npm run lint:types",
    "lint:changed": "node scripts/lint-changed.mjs --full-oxlint",
    "lint:fast": "node scripts/lint-changed.mjs",
    "lint:fix": "npx biome check --write --unsafe --no-errors-on-unmatched . && npx biome format --write --no-errors-on-unmatched . && npx knip",
    "lint:oxlint": "npx oxlint --config .oxlintrc.json --format stylish --no-error-on-unmatched-pattern .",
    "lint:compiler": "npx react-compiler-tracker",
    "lint:biome": "npx biome check --no-errors-on-unmatched .",
    "lint:architecture": "npx depcruise --config .dependency-cruiser.cjs src vite.config.ts",
    "lint:fallow": "node scripts/fallow-lint.mjs",
    "lint:audit": "npm audit --audit-level=high",
    "lint:types": "tsc -b",
    "pwa:env": "node scripts/pwa-production-env.mjs",
    "pwa:qa": "node scripts/pwa-qa.mjs",
    "pwa:release": "npm run pwa:env && npm run build && npm run pwa:qa",
    "audit:auth": "node scripts/audit/run-authenticated-pipeline.mjs",
    "audit:cert": "node scripts/audit/setup-local-preview-cert.mjs",
    "audit:lighthouse": "node scripts/audit/run-lighthouse.mjs",
    "audit:playwright": "node scripts/audit/run-playwright.mjs",
    "audit:serve": "node scripts/audit/static-preview-server.mjs",
    "test:unit": "vitest run test/unit",
    "check": "npm run lint && npm run lint:audit",
    "prepare": "npx husky"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6",
    "@giphy/js-fetch-api": "^5.8.0",
    "@giphy/js-types": "^5.1.0",
    "@giphy/react-components": "^10.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-oauth/google": "^0.13.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.162.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-delaunay": "^6.0.4",
    "dayjs": "^1.11.19",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.3",
    "frimousse": "^0.3.0",
    "input-otp": "^1.4.2",
    "ky": "^1.14.3",
    "lucide-react": "^0.575.0",
    "nuqs": "^2.8.9",
    "qr-code-styling": "^1.9.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "styled-components": "^6.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@bensandee/eslint-plugin": "^0.12.0",
    "@biomejs/biome": "^2.4.14",
    "@doist/react-compiler-tracker": "^2.3.3",
    "@playwright/test": "^1.60.0",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "chrome-launcher": "^1.2.1",
    "dependency-cruiser": "^17.4.0",
    "fallow": "^2.89.0",
    "husky": "^9.1.7",
    "knip": "^6.12.0",
    "lighthouse": "^12.8.2",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.63.0",
    "oxlint-plugin-inhuman": "^0.1.9",
    "oxlint-plugin-query": "^0.1.1",
    "oxlint-tailwindcss": "^0.7.1",
    "oxlint-tsgolint": "^0.22.1",
    "shadcn": "^3.8.5",
    "sharp": "^0.34.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "js-cookie": "^3.0.8",
    "uuid": "^11.1.1"
  }
}
