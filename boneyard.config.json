{
  "breakpoints": [390, 768, 1280],
  "out": "./src/bones",
  "routes": [
    "/design-system/boneyard/activity",
    "/design-system/boneyard/auth",
    "/design-system/boneyard/explore",
    "/design-system/boneyard/forge",
    "/design-system/boneyard/home",
    "/design-system/boneyard/landing",
    "/design-system/boneyard/onboarding",
    "/design-system/boneyard/profile",
    "/design-system/boneyard/sections",
    "/design-system/boneyard/settings"
  ],
  "wait": 800,
  "color": "var(--boneyard-bone-light)",
  "darkColor": "var(--boneyard-bone-dark)",
  "animate": "pulse",
  "shimmerColor": "var(--boneyard-shimmer-light)",
  "darkShimmerColor": "var(--boneyard-shimmer-dark)",
  "speed": "2.4s",
  "shimmerAngle": 110,
  "stagger": false,
  "transition": false,
  "boneClass": "boneyard-bone"
}
