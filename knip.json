{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "unresolved",
    "duplicates",
    "binaries"
  ],
  "ignoreFiles": [
    "src/shared/hooks/use-pwa-runtime-diagnostics.ts",
    "src/shared/types/google-maps.d.ts",
    "src/shared/types/react-css-properties.d.ts"
  ],
  "ignoreDependencies": ["fallow", "react-doctor", "repomix"],
  "entry": [
    "scripts/**/*.{js,mjs}",
    "test/audit/**/*.ts",
    "test/setup/**/*.ts",
    "test/unit/**/*.test.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "*.{js,mjs,ts}",
    "scripts/**/*.{js,mjs}",
    "test/audit/**/*.ts",
    "test/setup/**/*.ts",
    "test/support/**/*.{ts,tsx}",
    "test/unit/**/*.{ts,tsx}",
    "src/**/*.css"
  ]
}
