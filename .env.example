# App and API (required)
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:6969/api/v1

# Media provider (optional; leave unset until a provider-owned origin exists)
VITE_MEDIA_BASE_URL=

# Optional browser integrations. Leave unset until the provider identity exists.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_STATIC_MAPS_ENABLED=false
VITE_GIPHY_API_KEY=

# Calendar export is unavailable unless a provider-backed release enables it.
VITE_CALENDAR_EXPORT_ENABLED=false

# Error reporting (optional; disabled when VITE_SENTRY_DSN is unset)
# VITE_SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id
# VITE_SENTRY_ENVIRONMENT=local
# VITE_SENTRY_RELEASE=findafew-frontend@local
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
