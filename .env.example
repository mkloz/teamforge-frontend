# App and API (required)
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:6969/api/v1
VITE_MEDIA_BASE_URL=https://mkloz-teamforge.s3.us-east-1.amazonaws.com

# Browser integrations (required for release builds)
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GIPHY_API_KEY=your-giphy-web-sdk-key

# Error reporting (optional; disabled when VITE_SENTRY_DSN is unset)
# VITE_SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id
# VITE_SENTRY_ENVIRONMENT=local
# VITE_SENTRY_RELEASE=teamforge-frontend@local
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
